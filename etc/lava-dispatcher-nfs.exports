# /etc/exports: the access control list for filesystems which may be exported
#		to NFS clients.  See exports(5).
#
# Example for NFSv2 and NFSv3:
# /srv/homes       hostname1(rw,sync,no_subtree_check) hostname2(ro,sync,no_subtree_check)
#
# Example for NFSv4:
# /srv/nfs4        gss/krb5i(rw,sync,fsid=0,crossmnt,no_subtree_check)
# /srv/nfs4/homes  gss/krb5i(rw,sync,no_subtree_check)
#

# The jobs extract the NFS root filesystem below the dispatcher download
# directory, so the path exported here has to be the directory the jobs
# actually write into. Update it when the worker is configured to use another
# one, with the dispatcher_download_dir key of the dispatcher configuration or
# with the --dispatcher-download-dir option, otherwise deploying over NFS fails
# with the root filesystem sitting outside any exported filesystem.

/var/lib/lava/dispatcher/tmp *(rw,no_root_squash,no_all_squash,async,no_subtree_check)

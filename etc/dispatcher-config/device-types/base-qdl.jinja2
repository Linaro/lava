{# device_type: QDL base type #}
{% extends 'base.jinja2' %}

{% set fastboot_sequence = ['no-flash-boot'] %}
{% set fastboot_serial_number = fastboot_serial_number|default("'0000000000'") %}
{% set board_qdl_id = board_qdl_id|default('00000000') %}
{# board_cid is the SoC specific chip ID reported by the device in EDL mode #}
{% set board_cid = board_cid|default('0420') %}
{% set board_id = board_id|default("QUSB_BULK_CID:" + board_cid + "_SN:" + board_qdl_id) %}
{# skip the fastboot serial number if the board doesn't boot to fastboot #}
{% if fastboot_serial_number in ["'0000000000'", '0000000000', '00000000'] %}
{% set device_info = device_info|default([{'board_id': board_id}, {'board_id': board_qdl_id}]) %}
{% else %}
{% set device_info = device_info|default([{'board_id': board_id}, {'board_id': fastboot_serial_number}, {'board_id': board_qdl_id}]) %}
{% endif %}

{% block body %}
adb_serial_number: "{{ adb_serial_number|default('0000000000') }}"
fastboot_serial_number: "{{ fastboot_serial_number|default('0000000000') }}"
fastboot_options: {{ fastboot_options|default([]) }}
board_qdl_id: '{{ board_qdl_id }}'
board_id: '{{ board_id }}'
usb_vendor_id: '05c6'
usb_product_id: '{{ usb_product_id|default('9008')}}'

actions:
  deploy:
    methods:
      nfs:
      fastboot:
{% if flasher_deploy_commands %}
      flasher:
        commands: {{ flasher_deploy_commands|yaml_quote }}
{% endif %}
{% if usbg_ms_commands %}
      usbg-ms:
        enable: {{ usbg_ms_commands["enable"] }}
        disable: {{ usbg_ms_commands["disable"] }}
{% endif %}
      qdl:
    connections:
      adb:
      fastboot:
      lxc:
      serial:

  boot:
    connections:
      adb:
      fastboot:
      serial:
    methods:
      minimal:
      fastboot: {{ fastboot_sequence }}
      u-boot:
        parameters:
          bootloader_prompt: {{ bootloader_prompt|default('=>') }}
          interrupt_prompt: {{ interrupt_prompt|default('Hit any key to stop autoboot') }}
          interrupt_char: "{{ interrupt_char|default('') }}"
          needs_interrupt: {{ uboot_needs_interrupt|default(True) }}
      qdl:
        parameters:
          command: qdl
          enter-commands: {{ qdl_enter_commands|default([]) }}
  test:
    methods:
      docker:
        options: {{ device_docker_options|default([]) }}
{% endblock body -%}

[Unit]
Description=lava-dispatcher-host daemon

[Service]
EnvironmentFile=-/etc/lava-dispatcher-host/lava-dispatcher-host
ExecStart=/usr/bin/lava-dispatcher-host-server $DISPATCHER_DOWNLOAD_DIR
ProtectSystem=full
ProtectKernelModules=true
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
